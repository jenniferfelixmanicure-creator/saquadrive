{
  "cli": {
    "version": ">= 18.12.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "hooks": {
        "pre_install": "pnpm install --no-frozen-lockfile"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://saquadrive.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "hooks": {
        "pre_install": "pnpm install --no-frozen-lockfile"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://saquadrive.onrender.com"
      }
    },
    "production": {
      "channel": "production",
      "hooks": {
        "pre_install": "pnpm install --no-frozen-lockfile"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://saquadrive.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
