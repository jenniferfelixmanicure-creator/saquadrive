{
  "expo": {
    "name": "ZeroRisco",
    "slug": "zerorisco-saquarema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerorisco",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0D0D"
    },
    "android": {
      "package": "com.zerorisco.driver.app",
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBr--KxYjgHbY7uoaeAzYsnc3y4iuK4hjs"
        }
      },

    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerorisco.driver.app",
      "config": {
        "googleMapsApiKey": "AIzaSyBr--KxYjgHbY7uoaeAzYsnc3y4iuK4hjs"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-navigation-bar",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permita que o ZeroRisco acesse sua localização para encontrar corridas próximas."
        }
      ],
      [
        "@maplibre/maplibre-react-native",
        {
          "RNMapLibreGLLocationLayerEnabled": true,
          "android": {
            "styleURL": "https://tiles.openfreemap.org/styles/liberty"
          }
        }
      ]
    ],
    "owner": "pitaandre",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark",
        "legacyVisible": "immersive"
      },
      "eas": {
        "projectId": "c891dbd7-76fc-4255-941d-8b51d588483b"
      }
    }
  }
}
