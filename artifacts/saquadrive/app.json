{
  "expo": {
    "name": "ZeroRisco",
    "slug": "zerorisco-saquarema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerorisco",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "splash": {
      "backgroundColor": "#0D0D0D"
    },
    "android": {
      "package": "com.zerorisco.driver.app",
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerorisco.driver.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "dark": {
            "backgroundColor": "#0D0D0D"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o ZeroRisco acesse suas fotos para envio de documentos."
        }
      ],
      "expo-navigation-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permita que o ZeroRisco acesse sua localização para encontrar corridas próximas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D0D0D",
          "androidMode": "default",
          "androidCollapsedTitle": "ZeroRisco"
        }
      ]
    ],
    "owner": "zerorisco1",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark",
        "legacyVisible": "immersive"
      },
      "eas": {
        "projectId": "c9dd3c77-2341-4451-a969-83960056a7b5"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/c9dd3c77-2341-4451-a969-83960056a7b5"
    }
  }
}
