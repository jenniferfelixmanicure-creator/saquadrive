{
  "expo": {
    "name": "ZeroRisco",
    "slug": "zerorisco-saquarema",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerorisco",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0D0D0D",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "dark-content",
      "backgroundColor": "#00000000"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D0D0D"
    },
    "android": {
      "package": "com.zerorisco.driver.app",
      "softwareKeyboardLayoutMode": "pan",
      "splash": {
        "image": "./assets/images/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0D0D0D"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerorisco.driver.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "dark": {
            "backgroundColor": "#0D0D0D",
            "image": "./assets/images/splash.png",
            "resizeMode": "cover"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-navigation-bar",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Permita que o ZeroRisco acesse sua localização para encontrar corridas próximas."
        }
      ]
    ],
    "owner": "zeroriscoo",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark",
        "legacyVisible": "immersive"
      },
      "eas": {
        "projectId": "5b15ba73-cca4-4063-ad38-8cc0fa24d08c"
      }
    }
  }
}